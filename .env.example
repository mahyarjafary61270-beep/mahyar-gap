# ──────────────────────────────────────────────────────────────
# Mahyar Gap — environment configuration
# Copy the required values into Railway → Variables (or a local .env file).
# NEVER commit a real .env to GitHub.
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (Railway → your Postgres service → "DATABASE_URL")
# Local Postgres example: postgresql://postgres:postgres@localhost:5432/mahyar_gap
DATABASE_URL=

# Long random secret used to sign authentication tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# LiveKit Cloud project credentials (LiveKit Cloud → Settings → Keys)
# The URL looks like: wss://your-project-xxxx.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Runtime environment ("production" on Railway)
NODE_ENV=production

# ── Optional ──────────────────────────────────────────────────

# First-time owner bootstrap. If set and the users table is empty,
# this account is created automatically on first start.
# Leave empty to use the in-app first-run setup instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# Public origin of the app (used only for CORS tightening; leave empty to allow same-origin only)
PUBLIC_ORIGIN=

# Explicit listen port (Railway injects PORT automatically)
# PORT=3000
